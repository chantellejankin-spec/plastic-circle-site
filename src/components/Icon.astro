  message: '<path d="M4 5h16v11H8l-4 4V5z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="13" y2="13"/>',
  wave: '<path d="M2 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/><path d="M2 10c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/>',
};
---

<span class={`icon-badge ${variant}`}>
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icons[name] ?? ''}
  />
</span>

<style>
  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .icon-badge.default {
    background: var(--wine);
    color: var(--blush-pale);
  }

  .icon-badge.inverse {
    background: var(--blush-pale);
    color: var(--wine);
  }

  .icon-badge.plain {
    background: none;
    color: var(--wine);
    width: auto;
    height: auto;
  }
</style>
