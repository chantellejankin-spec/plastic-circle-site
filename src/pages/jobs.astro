---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL;

const jobs = [
  {
    title: 'Senior Finance and Administrative Officer',
    summary:
      'Oversees financial management and administrative operations for the project: budgeting, financial reporting, donor compliance, procurement and general office administration.',
    tags: ['Finance & Admin'],
    file: '01-senior-finance-and-administrative-officer.pdf',
  },
  {
    title: 'Sales and Marketing Manager',
    summary:
      'Leads sales and marketing efforts to drive adoption of circular economy products and services, building relationships with clients, retailers and municipalities.',
    tags: ['Sales & Marketing'],
    file: '02-sales-and-marketing-manager.pdf',
  },
  {
    title: 'Production Supervisor',
    summary:
      'Oversees daily operations of the production unit, ensuring efficient, safe and quality-driven processing and manufacturing of recycled plastic products.',
    tags: ['Production'],
    file: '03-production-supervisor.pdf',
  },
  {
    title: 'Product Design Lead',
    summary:
      'Leads the design and development of products made from recycled plastics, from concept through prototyping, testing and launch.',
    tags: ['Design'],
    file: '04-product-design-lead.pdf',
  },
  {
    title: 'Industrial / Product Designer',
    summary:
      'Designs, develops and prototypes plastic products that reduce waste and support circularity, working closely with engineers and sustainability experts.',
    tags: ['Design'],
    file: '05-industrial-product-designer.pdf',
  },
  {
    title: 'Senior Technician / Maintenance',
    summary:
      'Maintains, troubleshoots and optimises the equipment and machinery used in plastic waste processing and recycling operations.',
    tags: ['Maintenance'],
    file: '06-senior-technician-maintenance.pdf',
  },
  {
    title: 'Quality Assurance / Safety Officer',
    summary:
      'Ensures all project activities comply with quality standards, safety protocols and environmental regulations, protecting people, equipment and the environment.',
    tags: ['Quality & Safety'],
    file: '07-quality-assurance-safety-officer.pdf',
  },
  {
    title: 'CAD / Prototyping Support Specialist',
    summary:
      'Produces detailed CAD models and develops prototypes, supporting iterative design improvements from concept through production.',
    tags: ['Design'],
    file: '08-cad-prototyping-support-specialist.pdf',
  },
  {
    title: 'Workshop Fabrication Lead',
    summary:
      'Coordinates and supervises workshop fabrication activities, keeping production safe, efficient and in line with approved drawings and quality standards.',
    tags: ['Production'],
    file: '09-workshop-fabrication-lead.pdf',
  },
];
---

<Layout
  title="Jobs"
  description="Open positions across Plastic Circle West Africa's country platforms, recruited by our local implementation partners."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow reveal"><a href={base} style="color:inherit;">&larr; Plastic Circle West Africa</a></p>
      <h1 class="reveal">Jobs</h1>
      <p class="lede reveal">
        Our country platforms are building local teams across finance,
        sales, production, design and quality. Roles below are recruited
        by our local implementation partners, in anticipation of donor
        approval.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card-head reveal">
        <Icon name="briefcase" />
        <h2 style="margin:0;">Open roles</h2>
      </div>

      <div class="job-list reveal">
        {jobs.map((job) => (
          <div class="job-item">
            <div class="job-main">
              <h3>{job.title}</h3>
              <p>{job.summary}</p>
              <div class="job-tags">
                <span class="tag">The Gambia</span>
                {job.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <div class="job-apply">
              <a class="pill-btn outline" href={`${base}documents/${job.file}`}>Download Job Description</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
