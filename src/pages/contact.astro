---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Contact"
  description="Get in touch about Plastic Circle West Africa, DecoPlastic in Sierra Leone or Plastic Loop in The Gambia."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow reveal"><a href={base} style="color:inherit;">&larr; Plastic Circle West Africa</a></p>
      <h1 class="reveal">Get in Touch</h1>
      <p class="lede reveal">
        For questions about Plastic Circle West Africa, DecoPlastic in
        Sierra Leone or Plastic Loop in The Gambia, reach out below.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card-grid reveal">
        <div class="card">
          <h3>Ayara Foundation Switzerland</h3>
          <p>Programme lead for Plastic Circle West Africa.</p>
          <p>
            <a class="text-link" href="https://www.ayarafoundation.com">www.ayarafoundation.com</a>
          </p>
        </div>
        <div class="card">
          <h3>Hustle for Humanity Gambia</h3>
          <p>Local implementation lead for Plastic Loop, The Gambia.</p>
          <p>
            <a class="text-link" href="mailto:plasticloopgambia@gmail.com">plasticloopgambia@gmail.com</a>
          </p>
        </div>
        <div class="card">
          <h3>Sierra Leone Engineering Solutions</h3>
          <p>Local implementation lead for DecoPlastic, Sierra Leone.</p>
          <p>
            <a class="text-link" href="https://www.ayarafoundation.com">Via Ayara Foundation Switzerland</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
