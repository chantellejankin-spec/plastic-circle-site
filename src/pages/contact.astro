---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Contact"
  description="Get in touch with Ayara Foundation Switzerland about Plastic Circle West Africa."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow reveal"><a href={base} style="color:inherit;">&larr; Plastic Circle West Africa</a></p>
      <h1 class="reveal">Get in Touch</h1>
      <p class="lede reveal">
        For partnership, funding or media enquiries about Plastic Circle West
        Africa, DecoPlastic (Sierra Leone) or Plastic Loop (The Gambia),
        reach out to Ayara Foundation Switzerland.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card-grid cols-2 reveal">
        <div class="card">
          <h3>Ayara Foundation Switzerland</h3>
          <p>Gerechtigkeitsgasse 17<br />8001 Zurich, Switzerland</p>
          <p>
            <a class="text-link" href="mailto:ayarafoundation@yandex.com">ayarafoundation@yandex.com</a><br />
            <a class="text-link" href="tel:+41445007551">+41 (0) 44 500 75 51</a>
          </p>
          <p><a class="text-link" href="https://www.ayarafoundation.com">www.ayarafoundation.com &rarr;</a></p>
        </div>
        <div class="card">
          <h3>Plastic Loop Gambia enquiries</h3>
          <p>
            For HFH-Gambia recruitment and local partnership enquiries for
            Plastic Loop:
          </p>
          <p><a class="text-link" href="mailto:plasticloopgambia@gmail.com">plasticloopgambia@gmail.com</a></p>
        </div>
      </div>
    </div>
  </section>
</Layout>
